# Production Environment Variables Template
# คัดลอกไฟล์นี้และเปลี่ยนชื่อเป็น .env.production
# แล้วกรอกค่าจริงลงไป

# ===== DATABASE CONFIGURATION =====
# คัดลอกจาก Railway MySQL service → Variables tab
DB_HOST=your-mysql-host.railway.internal
DB_PORT=3306
DB_USER=root
DB_PASS=your-mysql-password
DB_NAME=railway

# ===== SESSION SECRET =====
# สร้างค่าใหม่ที่ปลอดภัย (ยาวและสุ่ม)
# ใช้เครื่องมือ: https://randomkeygen.com/
SECRET=CHANGE-THIS-TO-A-LONG-RANDOM-STRING-IN-PRODUCTION

# ===== CLIENT URL =====
# URL ของ Frontend (Railway จะให้ URL หลัง deploy)
CLIENT=https://your-frontend-name.up.railway.app

# ===== FACEBOOK OAUTH =====
# Get from: https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=https://your-backend-name.up.railway.app/auth/facebook/callback

# ===== GOOGLE OAUTH =====
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-backend-name.up.railway.app/auth/google/callback

# ===== IMPORTANT NOTES =====
# 1. เปลี่ยน "your-backend-name" และ "your-frontend-name" ให้ตรงกับ URL จริงจาก Railway
# 2. อย่าลืมอัพเดท callback URLs ใน Facebook Developer Console และ Google Cloud Console
# 3. ใช้ HTTPS เท่านั้น (ไม่ใช่ HTTP)
# 4. อย่า commit ไฟล์ .env.production ขึ้น GitHub (เพิ่มใน .gitignore)
